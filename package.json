{
  "name": "lango-learn",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @lango-learn/web dev",
    "prebuild": "npx -y @proappstore/cli@latest check",
    "build": "pnpm --filter @lango-learn/web build",
    "preview": "pnpm --filter @lango-learn/web preview",
    "dev:marketing": "pnpm --filter @lango-learn/marketing dev",
    "build:marketing": "pnpm --filter @lango-learn/marketing build",
    "typecheck": "pnpm --filter @lango-learn/web exec tsc -b",
    "test": "pnpm --filter @lango-learn/web exec tsc -b && node --test tests/*.test.mjs",
    "lint": "eslint .",
    "check:migrations": "python3 scripts/check_migrations.py",
    "check:actions": "python3 scripts/check_actions.py",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.72.0"
  }
}
